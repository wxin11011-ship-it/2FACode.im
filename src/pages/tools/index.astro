---
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import Layout from '~/layouts/Layout.astro';
import { footerData, headerData, TOOL_LINKS } from '~/navigation';

const metadata = {
  title: 'Tools — 2FA Code & QR Generators',
  description:
    'Browser-only 2FA tools: generate live TOTP codes or build scannable authenticator QR codes. No secret upload.',
  ignoreTitleTemplate: true,
  canonical: 'https://2facode.im/tools',
  openGraph: {
    title: 'Tools — 2FA Code & QR Generators',
    description: 'Choose a browser-only 2FA tool: live codes or scannable QR from a secret.',
    type: 'website',
    siteName: '2FACode.im',
    images: [
      {
        url: 'https://2facode.im/images/2facode-og.png',
        width: 1200,
        height: 630,
        alt: '2FACode.im tools',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky showToggleTheme={true} />

  <main id="main-content" class="tools-hub">
    <Breadcrumbs currentLabel="Tools" />
    <section class="hub-hero">
      <p class="hub-kicker">2FACode.im</p>
      <h1>Tools</h1>
      <p class="hub-intro">
        Two private browser tools for TOTP: get live codes for login, or build a QR your authenticator app can scan.
        Secrets stay in the tab.
      </p>
    </section>

    <section class="hub-grid" aria-label="Available tools">
      {
        TOOL_LINKS.map((tool, index) => (
          <a class="hub-card" href={tool.href}>
            <span class="hub-index">{String(index + 1).padStart(2, '0')}</span>
            <h2>{tool.text}</h2>
            <p>{tool.description}</p>
            <span class="hub-cta">Open tool →</span>
          </a>
        ))
      }
    </section>

    <p class="hub-note">
      Need policies or security details?
      <a href="/security">Security</a>
      ·
      <a href="/privacy">Privacy</a>
      ·
      <a href="/about">About</a>
    </p>
  </main>

  <Footer {...footerData} />
</Layout>

<style is:global>
  :root {
    --canvas: #f5f5f7;
    --surface-strong: rgba(255, 255, 255, 0.96);
    --surface-soft: rgba(255, 255, 255, 0.65);
    --text: #1d1d1f;
    --muted: #6e6e73;
    --hairline: rgba(0, 0, 0, 0.08);
    --action: #0071e3;
  }

  .dark {
    --canvas: #050505;
    --surface-strong: rgba(24, 24, 25, 0.96);
    --surface-soft: rgba(31, 31, 33, 0.7);
    --text: #f5f5f7;
    --muted: #a1a1a6;
    --hairline: rgba(255, 255, 255, 0.12);
    --action: #2997ff;
  }

  body {
    margin: 0;
    color: var(--text);
    background: var(--canvas);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
  }

  #header {
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--canvas) 78%, transparent);
    backdrop-filter: blur(20px) saturate(160%);
  }

  #header.scroll {
    border-bottom-color: var(--hairline);
  }

  .tools-hub {
    width: min(100% - 2rem, 64rem);
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  @media (min-width: 640px) {
    .tools-hub {
      width: min(100% - 3rem, 64rem);
      padding-top: 2.5rem;
    }
  }

  .hub-hero {
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  .hub-kicker {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hub-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 740;
    letter-spacing: -0.03em;
  }

  .hub-intro {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    padding: 1.25rem 1.3rem 1.35rem;
    background: var(--surface-strong);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease,
      transform 100ms ease;
  }

  .hub-card:hover {
    border-color: color-mix(in srgb, var(--action) 35%, var(--hairline));
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  .hub-index {
    color: var(--action);
    font:
      700 0.72rem/1 ui-monospace,
      monospace;
  }

  .hub-card h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hub-card p {
    margin: 0;
    flex: 1;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .hub-cta {
    margin-top: 0.55rem;
    color: var(--action);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .hub-note {
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hub-note a {
    color: var(--action);
    font-weight: 600;
  }

  footer {
    border-color: var(--hairline) !important;
    background: var(--canvas) !important;
  }

  @media (max-width: 640px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
