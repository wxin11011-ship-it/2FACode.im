---
import { getCanonical, getHomePermalink, getPermalink, trimSlash } from '~/utils/permalinks';

export interface CrumbItem {
  label: string;
  /** Omit href on the current (last) crumb */
  href?: string;
}

export interface Props {
  /** Optional explicit trail. When omitted, crumbs are derived from the URL path. */
  items?: CrumbItem[];
  currentLabel?: string;
  class?: string;
}

const { items, currentLabel = '', class: className = '' } = Astro.props;

const friendlyLabels: Record<string, string> = {
  tools: 'Tools',
  guides: 'Guides',
  about: 'About',
  security: 'Security',
  privacy: 'Privacy',
  terms: 'Terms',
  disclaimer: 'Disclaimer',
  '2fa-qr-code-generator': '2FA QR Code Generator',
  'totp-verifier': 'TOTP Verifier',
  'totp-secret-key-generator': 'TOTP Secret Key Generator',
  '2fa-code-not-working': '2FA Code Not Working',
};

const toTitle = (segment: string) =>
  decodeURIComponent(segment)
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (ch) => ch.toUpperCase());

let crumbs: CrumbItem[] = [];

if (items?.length) {
  crumbs = items;
} else {
  const pathSegments = trimSlash(new URL(Astro.url).pathname).split('/').filter(Boolean);

  crumbs = pathSegments.map((segment, index) => {
    const href = getPermalink(`/${pathSegments.slice(0, index + 1).join('/')}`);
    const fallback = friendlyLabels[segment.toLowerCase()] || toTitle(segment);
    const label = index === pathSegments.length - 1 && currentLabel ? currentLabel : fallback;
    const isLast = index === pathSegments.length - 1;
    return isLast ? { label } : { label, href };
  });
}

const shouldRender = crumbs.length > 0;
---

{
  shouldRender && (
    <nav aria-label="Breadcrumb" class:list={['site-breadcrumb', className]}>
      <ol class="crumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={getHomePermalink()} itemprop="item">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        {crumbs.map((crumb, index) => {
          const isLast = index === crumbs.length - 1 || !crumb.href;
          const itemUrl = crumb.href ? String(getCanonical(crumb.href)) : String(getCanonical(Astro.url.pathname));
          return (
            <>
              <li class="crumb-sep" aria-hidden="true">
                /
              </li>
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                {isLast ? (
                  <>
                    <span class="crumb-current" aria-current="page" itemprop="name">
                      {crumb.label}
                    </span>
                    <meta itemprop="item" content={itemUrl} />
                  </>
                ) : (
                  <a href={crumb.href} itemprop="item">
                    <span itemprop="name">{crumb.label}</span>
                  </a>
                )}
                <meta itemprop="position" content={String(index + 2)} />
              </li>
            </>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .site-breadcrumb {
    margin: 0 0 1rem;
  }

  .crumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted, #6e6e73);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .crumb-list a {
    color: inherit;
    text-decoration: none;
  }

  .crumb-list a:hover {
    color: var(--action, #0071e3);
  }

  .crumb-sep {
    color: color-mix(in srgb, var(--muted, #6e6e73) 70%, transparent);
    user-select: none;
  }

  .crumb-current {
    color: var(--text, #1d1d1f);
    font-weight: 600;
  }

  :global(.dark) .crumb-current {
    color: var(--text, #f5f5f7);
  }
</style>
