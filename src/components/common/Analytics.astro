---
/**
 * PageView: light page analytics — load immediately (defer only, no artificial delay).
 * Microsoft Clarity: session heatmap — load after window load + timeout so it
 * does not compete with first paint or the generator UI.
 */
const pageviewDomain = '2facode.im';
const clarityId = 'xrckrl0mqs';
const clarityDelayMs = 3000;
---

<script is:inline defer data-domain={pageviewDomain} src="https://app.pageview.app/js/script.js"></script>
<script is:inline define:vars={{ clarityId, clarityDelayMs }}>
  window.addEventListener('load', function () {
    window.setTimeout(function () {
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function (...args) {
            (c[a].q = c[a].q || []).push(args);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    }, clarityDelayMs);
  });
</script>
