---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme }}>
  if (!window.twoFactorUiInitialized) {
    window.twoFactorUiInitialized = true;

    const header = document.getElementById('header');
    const themeButton = document.querySelector('[data-aw-toggle-color-scheme]');

    const isDark = document.documentElement.classList.contains('dark');
    themeButton?.setAttribute('aria-pressed', String(isDark));
    themeButton?.addEventListener('click', () => {
      if (defaultTheme?.endsWith(':only')) return;

      const nextIsDark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', nextIsDark);
      themeButton.setAttribute('aria-pressed', String(nextIsDark));

      try {
        localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
      } catch {
        // The visual choice still applies when browser storage is unavailable.
      }
    });

    let scrollFramePending = false;
    function syncHeaderState() {
      header?.classList.toggle('scroll', window.scrollY > 60);
      scrollFramePending = false;
    }

    syncHeaderState();
    document.addEventListener(
      'scroll',
      () => {
        if (scrollFramePending) return;
        scrollFramePending = true;
        window.requestAnimationFrame(syncHeaderState);
      },
      { passive: true }
    );
  }
</script>
