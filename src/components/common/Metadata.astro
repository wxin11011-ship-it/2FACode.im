---
import merge from 'lodash.merge';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph, MetaDataTwitter } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical: canonicalProp,
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const pageTitle = title || METADATA?.title?.default || SITE?.name || '';
const titleTemplate = ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s';
const resolvedTitle = titleTemplate.includes('%s') ? titleTemplate.replace('%s', pageTitle) : pageTitle;
const canonical = canonicalProp || String(getCanonical(String(Astro.url.pathname)));
const resolvedDescription = description || METADATA?.description;
const shouldIndex = robots.index ?? METADATA?.robots?.index ?? false;
const shouldFollow = robots.follow ?? METADATA?.robots?.follow ?? false;

type OpenGraphWithLegacySiteName = MetaDataOpenGraph & { site_name?: string };

const mergedOpenGraph = merge(
  {
    url: canonical,
    siteName: SITE?.name,
    images: [],
    locale: I18N?.language || 'en',
    type: 'website',
  },
  METADATA?.openGraph || {},
  openGraph
) as OpenGraphWithLegacySiteName;

mergedOpenGraph.siteName ||= mergedOpenGraph.site_name;
mergedOpenGraph.title ||= resolvedTitle;
mergedOpenGraph.description ||= resolvedDescription;

const resolvedOpenGraph = await adaptOpenGraphImages(mergedOpenGraph, Astro.site);
const resolvedTwitter = merge(
  {
    cardType: resolvedOpenGraph.images?.length ? 'summary_large_image' : 'summary',
    title: resolvedOpenGraph.title,
    description: resolvedOpenGraph.description,
    image: resolvedOpenGraph.images?.[0]?.url,
  },
  METADATA?.twitter || {},
  twitter
) as MetaDataTwitter;
---

<title>{resolvedTitle}</title>
{resolvedDescription && <meta name="description" content={resolvedDescription} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={`${shouldIndex ? 'index' : 'noindex'}, ${shouldFollow ? 'follow' : 'nofollow'}`} />

<meta property="og:type" content={resolvedOpenGraph.type || 'website'} />
<meta property="og:url" content={resolvedOpenGraph.url || canonical} />
<meta property="og:title" content={resolvedOpenGraph.title || resolvedTitle} />
{resolvedOpenGraph.description && <meta property="og:description" content={resolvedOpenGraph.description} />}
{resolvedOpenGraph.siteName && <meta property="og:site_name" content={resolvedOpenGraph.siteName} />}
{resolvedOpenGraph.locale && <meta property="og:locale" content={resolvedOpenGraph.locale} />}
{
  resolvedOpenGraph.images?.map((image) => (
    <>
      <meta property="og:image" content={image.url} />
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
      {image.alt && <meta property="og:image:alt" content={image.alt} />}
    </>
  ))
}

<meta name="twitter:card" content={resolvedTwitter.cardType || 'summary'} />
{resolvedTwitter.site && <meta name="twitter:site" content={resolvedTwitter.site} />}
{resolvedTwitter.handle && <meta name="twitter:creator" content={resolvedTwitter.handle} />}
{resolvedTwitter.title && <meta name="twitter:title" content={resolvedTwitter.title} />}
{resolvedTwitter.description && <meta name="twitter:description" content={resolvedTwitter.description} />}
{resolvedTwitter.image && <meta name="twitter:image" content={resolvedTwitter.image} />}
