---
import { GITHUB_REPO_URL } from '~/navigation';
---

<section id="secret-generator" class="tool-shell" aria-labelledby="secret-tool-title" data-secret-tool>
  <div class="tool-shell-header">
    <h2 id="secret-tool-title">Create new enrollment material</h2>
    <p class="browser-badge">Browser only</p>
  </div>
  <form class="tool-form" data-secret-form novalidate>
    <div class="field-grid">
      <div class="tool-field">
        <label for="secret-account">Account name</label><input
          id="secret-account"
          data-secret-account
          type="text"
          maxlength="80"
          autocomplete="off"
          placeholder="alice@example.com"
        />
      </div>
      <div class="tool-field">
        <label for="secret-issuer">Issuer <span class="browser-badge">optional</span></label><input
          id="secret-issuer"
          data-secret-issuer
          type="text"
          maxlength="80"
          autocomplete="off"
          placeholder="Your app"
        />
      </div>
    </div>
    <details class="tool-options">
      <summary>Advanced TOTP settings</summary>
      <div class="option-grid">
        <div class="tool-field">
          <label for="secret-algorithm">Algorithm</label><select id="secret-algorithm" data-secret-algorithm
            ><option value="sha1">SHA-1</option><option value="sha256">SHA-256</option><option value="sha512"
              >SHA-512</option
            ></select
          >
        </div>
        <div class="tool-field">
          <label for="secret-digits">Digits</label><select id="secret-digits" data-secret-digits
            ><option value="6">6</option><option value="7">7</option><option value="8">8</option></select
          >
        </div>
        <div class="tool-field">
          <label for="secret-period">Period</label><select id="secret-period" data-secret-period
            ><option value="30">30 seconds</option><option value="15">15 seconds</option><option value="60"
              >60 seconds</option
            ><option value="90">90 seconds</option><option value="120">120 seconds</option></select
          >
        </div>
      </div>
    </details>
    <p class="tool-error" data-secret-error role="alert" aria-live="polite" hidden></p>
    <div class="tool-actions">
      <div class="button-row">
        <button type="submit" class="primary-action">Generate 160-bit secret</button>
        <button type="button" class="secondary-action" data-secret-clear>Clear</button>
      </div>
      <p class="trust-note">
        Web Crypto · <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">View source</a>
      </p>
    </div>
  </form>
  <div class="tool-result" data-secret-result hidden aria-live="polite">
    <div class="secret-output">
      <div class="secret-values">
        <div class="output-block">
          <label for="generated-secret">Base32 secret</label><div class="output-row">
            <input id="generated-secret" data-secret-output readonly spellcheck="false" /><button
              type="button"
              class="secondary-action"
              data-copy-secret>Copy</button
            >
          </div>
        </div>
        <div class="output-block">
          <label for="generated-uri">otpauth URI</label><textarea
            id="generated-uri"
            data-uri-output
            readonly
            spellcheck="false"></textarea>
        </div>
        <div class="button-row">
          <button type="button" class="secondary-action" data-copy-uri>Copy URI</button><button
            type="button"
            class="secondary-action"
            data-download-qr>Download QR PNG</button
          >
        </div>
        <p class="warning-note">
          Save the secret in your application’s protected credential store before clearing this tab. This generator
          cannot recover it later.
        </p>
      </div>
      <div class="qr-output">
        <canvas data-secret-qr width="220" height="220" aria-label="Generated TOTP enrollment QR code"></canvas><span
          class="browser-badge">Scan only on a trusted device</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  import QRCode from 'qrcode';
  import { buildOtpauthUri, generateRandomSecret } from '~/scripts/totp.mjs';

  const tool = document.querySelector('[data-secret-tool]');
  if (tool instanceof HTMLElement && tool.dataset.ready !== 'true') {
    tool.dataset.ready = 'true';
    const form = tool.querySelector('[data-secret-form]');
    const account = tool.querySelector('[data-secret-account]');
    const issuer = tool.querySelector('[data-secret-issuer]');
    const algorithm = tool.querySelector('[data-secret-algorithm]');
    const digits = tool.querySelector('[data-secret-digits]');
    const period = tool.querySelector('[data-secret-period]');
    const error = tool.querySelector('[data-secret-error]');
    const result = tool.querySelector('[data-secret-result]');
    const secretOutput = tool.querySelector('[data-secret-output]');
    const uriOutput = tool.querySelector('[data-uri-output]');
    const canvas = tool.querySelector('[data-secret-qr]');
    let activeSecret = '';
    let activeUri = '';

    const setError = (value: string) => {
      if (!(error instanceof HTMLElement)) return;
      error.textContent = value;
      error.hidden = !value;
    };
    const copy = async (value: string, button: Element | null) => {
      try {
        await navigator.clipboard.writeText(value);
        if (button instanceof HTMLButtonElement) {
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => (button.textContent = original), 1200);
        }
      } catch {
        setError('Clipboard access was blocked. Select the value and copy it manually.');
      }
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      setError('');
      try {
        activeSecret = generateRandomSecret();
        activeUri = buildOtpauthUri({
          secret: activeSecret,
          label: account instanceof HTMLInputElement ? account.value.trim() || 'Account' : 'Account',
          issuer: issuer instanceof HTMLInputElement ? issuer.value.trim() : '',
          algorithm: algorithm instanceof HTMLSelectElement ? algorithm.value : 'sha1',
          digits: digits instanceof HTMLSelectElement ? Number(digits.value) : 6,
          period: period instanceof HTMLSelectElement ? Number(period.value) : 30,
        });
        if (secretOutput instanceof HTMLInputElement) secretOutput.value = activeSecret;
        if (uriOutput instanceof HTMLTextAreaElement) uriOutput.value = activeUri;
        if (!(canvas instanceof HTMLCanvasElement)) throw new Error('QR canvas is unavailable.');
        await QRCode.toCanvas(canvas, activeUri, {
          width: 220,
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark: '#1d1d1f', light: '#ffffff' },
        });
        if (result instanceof HTMLElement) result.hidden = false;
        result?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (cause) {
        if (result instanceof HTMLElement) result.hidden = true;
        setError(cause instanceof Error ? cause.message : 'A secret could not be generated.');
      }
    });

    const copySecret = tool.querySelector('[data-copy-secret]');
    const copyUri = tool.querySelector('[data-copy-uri]');
    copySecret?.addEventListener('click', () => activeSecret && copy(activeSecret, copySecret));
    copyUri?.addEventListener('click', () => activeUri && copy(activeUri, copyUri));
    tool.querySelector('[data-download-qr]')?.addEventListener('click', () => {
      if (!(canvas instanceof HTMLCanvasElement) || !activeUri) return;
      const link = document.createElement('a');
      link.download = 'totp-enrollment-qr.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
    tool.querySelector('[data-secret-clear]')?.addEventListener('click', () => {
      activeSecret = '';
      activeUri = '';
      if (form instanceof HTMLFormElement) form.reset();
      if (secretOutput instanceof HTMLInputElement) secretOutput.value = '';
      if (uriOutput instanceof HTMLTextAreaElement) uriOutput.value = '';
      if (canvas instanceof HTMLCanvasElement) canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
      if (result instanceof HTMLElement) result.hidden = true;
      setError('');
      if (account instanceof HTMLInputElement) account.focus();
    });
  }
</script>
