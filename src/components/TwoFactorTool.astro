---
import { GITHUB_REPO_URL } from '~/navigation';
---

<section id="generator" class="tool-wrap" aria-labelledby="generator-title">
  <div class="tool-card" data-totp-tool>
    <div class="tool-topline">
      <h2 id="generator-title">Paste secrets, generate codes</h2>
      <p class="local-status" title="Code generation runs in this browser">Browser only</p>
    </div>

    <form class="tool-form" data-totp-form novalidate>
      <div class="field-heading">
        <label for="totp-input">2FA secret keys</label>
        <span data-line-count>0 / 50 lines</span>
      </div>
      <textarea
        id="totp-input"
        data-totp-input
        name="secrets"
        rows="6"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder={'Paste one secret per line…\nAccount name | BASE32SECRET\notpauth://totp/…'}
        aria-describedby="input-help input-errors"></textarea>
      <div id="input-help" class="input-help">
        <p>Gray text is only a hint — paste to replace it. One secret per line, up to 50.</p>
        <button type="button" class="text-button" data-demo>Try demo key</button>
      </div>

      <div id="input-errors" class="input-errors" data-errors role="alert" aria-live="polite" hidden></div>

      <div class="form-actions">
        <button type="submit" class="primary-button">Generate codes</button>
        <p class="trust-note">
          Nothing is stored.
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">View source</a>
        </p>
      </div>
    </form>

    <div class="results" data-results hidden aria-live="polite">
      <div class="results-heading">
        <h3 data-results-title>Generated codes</h3>
        <div class="result-actions">
          <button type="button" class="secondary-button" data-copy-all>Copy all</button>
          <button type="button" class="secondary-button subtle" data-clear>Clear</button>
        </div>
      </div>
      <div class="code-list" data-code-list></div>
      <p class="result-note">Codes refresh automatically. Clear when you are done.</p>
    </div>
  </div>
</section>

<script>
  import { TotpInputError, generateTotp, getSecondsRemaining, maskSecret, parseInput } from '~/scripts/totp.mjs';

  type TotpEntry = {
    id: string;
    lineNumber: number;
    label: string;
    secret: string;
    algorithm: string;
    digits: number;
    period: number;
  };

  const tool = document.querySelector('[data-totp-tool]');

  if (tool instanceof HTMLElement && tool.dataset.ready !== 'true') {
    tool.dataset.ready = 'true';

    const form = tool.querySelector('[data-totp-form]');
    const input = tool.querySelector('[data-totp-input]');
    const lineCount = tool.querySelector('[data-line-count]');
    const errors = tool.querySelector('[data-errors]');
    const results = tool.querySelector('[data-results]');
    const resultsTitle = tool.querySelector('[data-results-title]');
    const codeList = tool.querySelector('[data-code-list]');
    const copyAll = tool.querySelector('[data-copy-all]');
    const clear = tool.querySelector('[data-clear]');
    const demo = tool.querySelector('[data-demo]');

    let activeEntries: TotpEntry[] = [];
    let activeTokens = new Map<string, string>();
    let timeSteps = new Map<string, number>();
    let generationId = 0;

    const setErrors = (items: string[]) => {
      if (!(errors instanceof HTMLElement)) return;
      errors.replaceChildren();

      if (!items.length) {
        errors.hidden = true;
        return;
      }

      const list = document.createElement('ul');
      for (const item of items) {
        const element = document.createElement('li');
        element.textContent = item;
        list.append(element);
      }
      errors.append(list);
      errors.hidden = false;
    };

    const formatToken = (token: string) => {
      const splitAt = Math.ceil(token.length / 2);
      return `${token.slice(0, splitAt)} ${token.slice(splitAt)}`;
    };

    const copyText = async (value: string, button: Element | null) => {
      try {
        await navigator.clipboard.writeText(value);
        if (button instanceof HTMLButtonElement) {
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = original;
          }, 1200);
        }
      } catch {
        setErrors(['Clipboard access was blocked. Select and copy the code manually.']);
      }
    };

    const createCodeRow = (entry: TotpEntry, token: string) => {
      const row = document.createElement('article');
      row.className = 'code-row';
      row.dataset.entryId = entry.id;

      const identity = document.createElement('div');
      identity.className = 'code-identity';
      const label = document.createElement('h4');
      label.textContent = entry.label;
      const meta = document.createElement('p');
      meta.textContent = `${maskSecret(entry.secret)} · ${entry.algorithm.toUpperCase()} · ${entry.period}s`;
      identity.append(label, meta);

      const value = document.createElement('div');
      value.className = 'code-value';
      const digits = document.createElement('output');
      digits.dataset.token = '';
      digits.textContent = formatToken(token);
      digits.setAttribute('aria-label', `Current code for ${entry.label}`);

      const timer = document.createElement('span');
      timer.className = 'timer-ring';
      timer.dataset.timer = '';
      timer.setAttribute('aria-label', 'Seconds remaining');

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-button';
      button.textContent = 'Copy';
      button.addEventListener('click', () => copyText(activeTokens.get(entry.id) || '', button));

      value.append(digits, timer, button);
      row.append(identity, value);
      return row;
    };

    const renderRows = () => {
      if (!(codeList instanceof HTMLElement)) return;
      codeList.replaceChildren();
      for (const entry of activeEntries) {
        const token = activeTokens.get(entry.id);
        if (token) codeList.append(createCodeRow(entry, token));
      }
    };

    const updateRow = (entry: TotpEntry, token: string) => {
      if (!(codeList instanceof HTMLElement)) return;
      const row = codeList.querySelector(`[data-entry-id="${entry.id}"]`);
      const output = row?.querySelector('[data-token]');
      if (output instanceof HTMLOutputElement) output.textContent = formatToken(token);
    };

    const generateEntries = async (entries: TotpEntry[], epoch: number, requestId: number) => {
      const generated = await Promise.allSettled(entries.map((entry) => generateTotp(entry, epoch)));
      if (requestId !== generationId) return [];

      const generationErrors: string[] = [];
      generated.forEach((result, index) => {
        const entry = entries[index];
        if (result.status === 'fulfilled') {
          activeTokens.set(entry.id, result.value);
        } else {
          generationErrors.push(`Line ${entry.lineNumber}: a code could not be generated.`);
        }
      });
      return generationErrors;
    };

    const updateTimers = async () => {
      if (!activeEntries.length || !(codeList instanceof HTMLElement)) return;
      const epoch = Date.now() / 1000;

      for (const entry of activeEntries) {
        const row = codeList.querySelector(`[data-entry-id="${entry.id}"]`);
        const timer = row?.querySelector('[data-timer]');
        const remaining = getSecondsRemaining(entry.period, epoch);
        const progress = remaining / entry.period;

        if (timer instanceof HTMLElement) {
          timer.textContent = String(remaining);
          timer.style.setProperty('--timer-progress', String(progress));
        }

        const timeStep = Math.floor(epoch / entry.period);
        if (timeSteps.get(entry.id) !== timeStep) {
          timeSteps.set(entry.id, timeStep);
          try {
            const token = await generateTotp(entry, epoch);
            activeTokens.set(entry.id, token);
            updateRow(entry, token);
          } catch {
            setErrors([`Line ${entry.lineNumber}: a code could not be refreshed.`]);
          }
        }
      }
    };

    const resetWorkspace = () => {
      generationId += 1;
      activeEntries = [];
      activeTokens = new Map();
      timeSteps = new Map();
      if (input instanceof HTMLTextAreaElement) {
        input.value = '';
        input.focus();
      }
      if (codeList instanceof HTMLElement) codeList.replaceChildren();
      if (results instanceof HTMLElement) results.hidden = true;
      if (lineCount instanceof HTMLElement) lineCount.textContent = '0 / 50 lines';
      setErrors([]);
    };

    input?.addEventListener('input', () => {
      if (!(input instanceof HTMLTextAreaElement) || !(lineCount instanceof HTMLElement)) return;
      const count = input.value.split(/\r?\n/).filter((line) => line.trim()).length;
      lineCount.textContent = `${count} / 50 lines`;
      lineCount.classList.toggle('over-limit', count > 50);
    });

    demo?.addEventListener('click', () => {
      if (!(input instanceof HTMLTextAreaElement)) return;
      input.value = 'Public RFC demo | GEZD GNBV GY3T QOJQ GEZD GNBV GY3T QOJQ';
      input.dispatchEvent(new Event('input'));
      input.focus();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(input instanceof HTMLTextAreaElement)) return;

      const requestId = ++generationId;
      setErrors([]);

      try {
        const parsed = parseInput(input.value);
        activeEntries = parsed.entries;
        activeTokens = new Map<string, string>();
        timeSteps = new Map<string, number>();

        const generationErrors = await generateEntries(activeEntries, Date.now() / 1000, requestId);
        const allErrors = [
          ...parsed.errors.map(
            (error: { lineNumber: number; message: string }) => `Line ${error.lineNumber}: ${error.message}`
          ),
          ...generationErrors,
        ];
        setErrors(allErrors);

        if (!activeTokens.size) {
          if (results instanceof HTMLElement) results.hidden = true;
          return;
        }

        renderRows();
        await updateTimers();
        if (resultsTitle instanceof HTMLElement) {
          resultsTitle.textContent = `${activeTokens.size} live code${activeTokens.size === 1 ? '' : 's'}`;
        }
        if (results instanceof HTMLElement) {
          results.hidden = false;
          results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } catch (error) {
        const message = error instanceof TotpInputError ? error.message : 'The codes could not be generated.';
        setErrors([message]);
        if (results instanceof HTMLElement) results.hidden = true;
      }
    });

    copyAll?.addEventListener('click', () => {
      const value = activeEntries
        .map((entry) => {
          const token = activeTokens.get(entry.id);
          return token ? `${entry.label}\t${token}` : '';
        })
        .filter(Boolean)
        .join('\n');
      if (value) copyText(value, copyAll);
    });

    clear?.addEventListener('click', resetWorkspace);
    window.setInterval(updateTimers, 500);
  }
</script>

<style>
  .tool-wrap {
    /* Stay inside the same column as the sticky header (max-w-5xl + gutters) */
    width: min(100% - 2rem, 58rem);
    margin: 0 auto;
    scroll-margin-top: 4.5rem;
  }

  @media (min-width: 640px) {
    .tool-wrap {
      width: min(100% - 3rem, 58rem);
    }
  }

  .tool-card {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--surface-strong);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .tool-topline,
  .results-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.15rem 0;
  }

  .tool-topline h2,
  .results-heading h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .local-status {
    margin: 0;
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .tool-form {
    padding: 0.95rem 1.15rem 1.15rem;
  }

  .field-heading,
  .input-help,
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .field-heading {
    margin-bottom: 0.65rem;
  }

  .field-heading label {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .field-heading span,
  .input-help,
  .form-actions p,
  .result-note {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .field-heading .over-limit {
    color: var(--error);
  }

  textarea {
    display: block;
    width: 100%;
    min-height: 8.75rem;
    resize: vertical;
    border: 1px solid var(--hairline-strong);
    border-radius: 0.75rem;
    padding: 0.85rem 0.9rem;
    color: var(--text);
    background: var(--input-bg);
    font:
      500 0.875rem/1.6 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    outline: none;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease,
      background 140ms ease;
  }

  textarea::placeholder {
    color: var(--placeholder);
    opacity: 0.72;
    font-weight: 400;
  }

  /* WebKit/Blink need explicit vendor rule for multi-line textarea placeholders */
  textarea::-webkit-input-placeholder {
    color: var(--placeholder);
    opacity: 0.72;
  }

  textarea::-moz-placeholder {
    color: var(--placeholder);
    opacity: 0.72;
  }

  textarea:focus {
    border-color: var(--action);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--action) 12%, transparent);
    background: var(--surface-strong);
  }

  .input-help {
    align-items: flex-start;
    margin-top: 0.7rem;
  }

  .input-help p {
    margin: 0;
  }

  code {
    color: var(--text);
    font: inherit;
  }

  .text-button,
  .secondary-button,
  .copy-button {
    border: 0;
    color: var(--action);
    background: transparent;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .text-button {
    flex: 0 0 auto;
    padding: 0;
    font-size: 0.78rem;
  }

  .input-errors {
    margin-top: 1rem;
    border: 1px solid color-mix(in srgb, var(--error) 28%, transparent);
    border-radius: 0.9rem;
    padding: 0.75rem 0.9rem;
    color: var(--error);
    background: color-mix(in srgb, var(--error) 7%, transparent);
    font-size: 0.8rem;
  }

  .input-errors ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .form-actions {
    margin-top: 1rem;
  }

  .form-actions p,
  .trust-note {
    max-width: 16rem;
    margin: 0;
    text-align: right;
    font-weight: 400;
    line-height: 1.45;
  }

  .trust-note a {
    color: var(--action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .trust-note a:hover {
    filter: brightness(1.05);
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border: 0;
    border-radius: 0.65rem;
    padding: 0.7rem 1.1rem;
    color: white;
    background: var(--action);
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      background 140ms ease,
      transform 90ms ease-out;
  }

  .primary-button:hover {
    background: color-mix(in srgb, var(--action) 88%, black);
  }

  .primary-button:active,
  .secondary-button:active,
  .copy-button:active,
  .text-button:active {
    transform: scale(0.98);
  }

  .results {
    border-top: 1px solid var(--hairline);
    background: var(--results-bg);
  }

  .results-heading {
    align-items: center;
    padding-bottom: 0.95rem;
  }

  .result-actions {
    display: flex;
    gap: 0.35rem;
  }

  .secondary-button,
  .copy-button {
    border: 1px solid var(--hairline);
    border-radius: 0.55rem;
    padding: 0.45rem 0.7rem;
    color: var(--text);
    background: var(--surface-strong);
    font-size: 0.75rem;
    font-weight: 600;
    transition:
      background 140ms ease,
      transform 90ms ease-out;
  }

  .secondary-button:hover,
  .copy-button:hover {
    background: var(--surface-hover);
  }

  .secondary-button.subtle {
    color: var(--muted);
  }

  .secondary-button.subtle:hover {
    color: var(--text);
  }

  .code-list {
    display: grid;
    gap: 0.55rem;
    padding: 0 1rem 1rem;
  }

  :global(.code-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    padding: 0.7rem 0.8rem 0.7rem 0.9rem;
    background: var(--surface-strong);
  }

  :global(.code-identity) {
    min-width: 0;
  }

  :global(.code-identity h4) {
    overflow: hidden;
    margin: 0 0 0.25rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 720;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.code-identity p) {
    margin: 0;
    color: var(--muted);
    font:
      500 0.68rem/1.3 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
  }

  :global(.code-value) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  :global(.code-value output) {
    min-width: 7ch;
    color: var(--text);
    font:
      720 clamp(1.25rem, 4vw, 1.65rem)/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.06em;
    transition: opacity 140ms ease;
  }

  :global(.timer-ring) {
    --timer-progress: 1;
    display: inline-grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    background:
      radial-gradient(circle, var(--surface-strong) 56%, transparent 58%),
      conic-gradient(var(--action) calc(var(--timer-progress) * 1turn), var(--hairline) 0);
    font:
      700 0.62rem/1 ui-monospace,
      monospace;
  }

  .result-note {
    margin: 0;
    padding: 0 1.15rem 1.15rem;
  }

  @media (max-width: 640px) {
    .tool-card {
      border-radius: 0.9rem;
    }

    .tool-topline,
    .results-heading,
    .tool-form {
      padding-left: 0.95rem;
      padding-right: 0.95rem;
    }

    .tool-form {
      padding-top: 0.85rem;
      padding-bottom: 1rem;
    }

    textarea {
      min-height: 7.25rem;
    }

    .primary-button {
      width: 100%;
    }

    .tool-topline,
    .input-help,
    .form-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .form-actions p,
    .trust-note {
      text-align: left;
      max-width: none;
    }

    :global(.code-row) {
      grid-template-columns: 1fr;
    }

    :global(.code-value) {
      justify-content: space-between;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .primary-button,
    .secondary-button,
    .copy-button,
    textarea {
      transition-duration: 0.01ms;
    }
  }
</style>
