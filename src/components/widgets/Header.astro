---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  showFeedback?: boolean;
  githubUrl?: string;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  showFeedback = true,
  githubUrl = '',
} = Astro.props;

const hasNavLinks = links.some((link) => Boolean(link.text));
const iconButtonClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-lg text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700';
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-2 px-4 sm:px-6 mx-auto w-full grid grid-cols-[1fr_auto_1fr] items-center gap-2',
      { 'max-w-5xl': !isFullWidth },
    ]}
  >
    <div class="flex items-center min-w-0 justify-self-start">
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
    </div>

    {
      hasNavLinks ? (
        <nav
          id="site-navigation"
          class="hidden lg:flex items-center justify-center justify-self-center text-default"
          aria-label="Main navigation"
        >
          <ul class="flex flex-row items-center gap-0.5">
            {links.map((menuLink) => {
              const text = menuLink.text;
              const href = menuLink.href;
              const childLinks = menuLink.links || [];
              if (!text) return null;

              if (childLinks.length > 0) {
                return (
                  <li class="dropdown relative">
                    <a
                      href={href || '/tools'}
                      class="hover:text-link dark:hover:text-white px-3 py-2 flex items-center gap-1 whitespace-nowrap text-[0.9375rem] font-medium"
                      aria-haspopup="true"
                    >
                      {text}
                      <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 opacity-70" />
                    </a>
                    {/*
                      pt-2 = invisible hover bridge (no gap under the trigger).
                      Outer ul stays hoverable so the menu does not vanish on the way down.
                    */}
                    <ul class="dropdown-menu hidden absolute left-1/2 top-full z-50 min-w-[15rem] -translate-x-1/2 pt-2">
                      <li class="list-none rounded-xl border border-gray-200/80 bg-white/95 py-1.5 shadow-lg backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/95">
                        <ul class="m-0 list-none p-0">
                          {childLinks.map((child) =>
                            child.text && child.href ? (
                              <li>
                                <a
                                  class="block px-3.5 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800"
                                  href={child.href}
                                >
                                  {child.text}
                                </a>
                              </li>
                            ) : null
                          )}
                        </ul>
                      </li>
                    </ul>
                  </li>
                );
              }

              if (!href) return null;
              return (
                <li>
                  <a
                    class="hover:text-link dark:hover:text-white px-3 py-2 flex items-center whitespace-nowrap text-[0.9375rem] font-medium"
                    href={href}
                  >
                    {text}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ) : (
        <div class="justify-self-center" aria-hidden="true" />
      )
    }

    <div class="flex items-center gap-0.5 sm:gap-1 shrink-0 justify-self-end" data-header-actions>
      {
        githubUrl && (
          <a
            class={iconButtonClass}
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View open-source code on GitHub"
            title="Open source on GitHub"
          >
            <Icon name="tabler:brand-github" class="w-5 h-5" />
          </a>
        )
      }

      {
        showFeedback && (
          <button
            type="button"
            data-feedback-trigger
            class={iconButtonClass}
            aria-label="Send feedback"
            title="Send feedback"
          >
            <Icon name="tabler:message-circle" class="w-5 h-5" />
          </button>
        )
      }

      {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" class={iconButtonClass} />}

      {
        showRssFeed && (
          <a class={iconButtonClass} aria-label="RSS Feed" href={getAsset('/rss.xml')}>
            <Icon name="tabler:rss" class="w-5 h-5" />
          </a>
        )
      }

      {
        actions?.length > 0 && (
          <span class="ml-1 hidden sm:inline-flex">
            {actions.map((btnProps) => (
              <Button {...btnProps} class="ml-1 py-2 px-4 font-semibold shadow-none text-sm w-auto" />
            ))}
          </span>
        )
      }

      {
        hasNavLinks && (
          <div class="lg:hidden">
            <ToggleMenu
              label="Open tools menu"
              class="flex flex-col h-10 w-10 rounded-lg justify-center items-center cursor-pointer group"
            />
          </div>
        )
      }
    </div>
  </div>

  {
    hasNavLinks && (
      <nav
        id="site-navigation-mobile"
        class="mobile-nav hidden lg:hidden border-t border-gray-200/70 dark:border-gray-800 px-4 sm:px-6 pb-3 pt-1"
        aria-label="Mobile navigation"
        data-mobile-nav
      >
        <ul class="flex flex-col py-1">
          {links.map((menuLink) => {
            const text = menuLink.text;
            const href = menuLink.href;
            const childLinks = menuLink.links || [];
            if (!text) return null;
            return (
              <li class="border-b border-gray-100 dark:border-gray-800 last:border-0">
                {href ? (
                  <a class="block py-2.5 text-base font-semibold" href={href}>
                    {text}
                  </a>
                ) : (
                  <span class="block py-2.5 text-base font-semibold">{text}</span>
                )}
                {childLinks.length > 0 && (
                  <ul class="pb-2 pl-3 flex flex-col gap-0.5">
                    {childLinks.map((child) =>
                      child.text && child.href ? (
                        <li>
                          <a class="block py-2 text-sm text-gray-600 dark:text-gray-300" href={child.href}>
                            {child.text}
                          </a>
                        </li>
                      ) : null
                    )}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</header>

<style>
  .mobile-nav {
    background: color-mix(in srgb, var(--canvas, #f5f5f7) 94%, transparent);
  }
</style>
