---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer
  class:list={[
    { dark: theme === 'dark' },
    'relative border-t border-gray-200 dark:border-gray-800 not-prose bg-white dark:bg-[#1a1a1a]',
  ]}
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 text-gray-600 dark:text-gray-400">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a
            class="inline-flex items-center font-bold text-xl text-gray-900 dark:text-white no-underline hover:opacity-90"
            href={getHomePermalink()}
            aria-label={SITE?.name || '2FACode.im'}
          >
            <span class="footer-brand-mark" aria-hidden="true"><span></span><span></span></span>
            <span class="footer-brand-word">
              {(SITE?.name || '2FACode.im').replace(/\.im$/i, '')}<span class="footer-brand-tld">.im</span>
            </span>
          </a>
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400 flex gap-1 flex-wrap">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="text-gray-900 dark:text-white font-medium mb-2">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-gray-100 dark:border-gray-800">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 text-gray-500 dark:text-gray-400">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-brand-mark {
    position: relative;
    display: inline-grid;
    width: 1.45rem;
    height: 1.45rem;
    margin-right: 0.5rem;
    place-items: center;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.45rem;
    background: #fff;
  }

  :global(.dark) .footer-brand-mark {
    border-color: rgba(255, 255, 255, 0.14);
    background: #181819;
  }

  .footer-brand-mark span {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }

  .footer-brand-mark span:first-child {
    transform: translate(-0.18rem, -0.06rem);
  }

  .footer-brand-mark span:last-child {
    transform: translate(0.18rem, 0.06rem);
    border-color: #0071e3;
  }

  .footer-brand-word {
    letter-spacing: -0.02em;
  }

  .footer-brand-tld {
    color: #6e6e73;
    font-weight: 650;
  }

  :global(.dark) .footer-brand-tld {
    color: #a1a1a6;
  }
</style>
