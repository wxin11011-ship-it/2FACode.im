<style is:inline>
  :root {
    --aw-font-sans: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
    --aw-font-serif: ui-serif, Georgia, serif;
    --aw-font-heading: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;

    --aw-color-primary: rgb(0 113 227);
    --aw-color-secondary: rgb(0 113 227);
    --aw-color-accent: rgb(36 138 61);

    --aw-color-text-heading: rgb(29 29 31);
    --aw-color-text-default: rgb(29 29 31);
    --aw-color-text-muted: rgb(110 110 115);
    --aw-color-bg-page: rgb(245 245 247);

    --aw-color-bg-page-dark: rgb(5 5 5);

    ::selection {
      color: white;
      background-color: rgb(0 113 227);
    }
  }

  .dark {
    --aw-color-primary: rgb(41 151 255);
    --aw-color-secondary: rgb(41 151 255);
    --aw-color-accent: rgb(48 209 88);

    --aw-color-text-heading: rgb(245 245 247);
    --aw-color-text-default: rgb(245 245 247);
    --aw-color-text-muted: rgb(161 161 166);
    --aw-color-bg-page: rgb(5 5 5);

    ::selection {
      color: white;
      background-color: rgb(41 151 255);
    }
  }
</style>
